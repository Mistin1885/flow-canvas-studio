FLOW_AUTH=cloudflare
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-application-audience
FLOW_ORIGIN=https://flow.example.com
FLOW_PORT=8768
