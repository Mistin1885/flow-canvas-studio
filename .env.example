FLOW_AUTH=cloudflare
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-application-audience
FLOW_ORIGIN=https://flow.example.com
FLOW_PORT=8768
# Optional read-only SQLite source for the first PostgreSQL startup.
# FLOW_DATA_DIR=/srv/flow-canvas-data
# Optional dedicated PostgreSQL host directory. The default is a named volume.
# FLOW_PGDATA=/srv/flow-canvas-postgres
# Optional for identities that omit both the GitHub account ID and login.
# FLOW_GITHUB_ID_MAP='{"access-user-uuid":12345}'
# Optional for non-public Enterprise Managed Users or higher API rate limits.
# FLOW_GITHUB_API_TOKEN=

# Native web only: libpq connection string for a PostgreSQL 18 database.
# FLOW_DATABASE_URL=postgresql:///flow
